{
  "$schema": "https://detectviz.dev/schemas/module.card.schema.json",
  "name": "health_aggregator",
  "version": "1.0.0",
  "description": "Aggregates health data from various sources via the MetricsProvider interface.",
  "language": "go",
  "entrypoint": "plugin.go",
  "classification": {
    "role": "plugin.gateway",
    "category": "observability",
    "subcategory": "metrics"
  },
  "dependencies": {
    "requires": [
      {
        "name": "detectviz.contracts",
        "version": ">=1.0.0",
        "type": "proto"
      }
    ]
  },
  "runtime": {
    "resources": {
      "min_memory_mb": 64,
      "max_memory_mb": 256
    },
    "timeout_seconds": 30
  },
  "observability": {
    "metrics_enabled": true,
    "tracing_enabled": true,
    "logging_level": "info",
    "tags": {
      "component": "health_aggregator"
    }
  },
  "security": {
    "permissions": [
      "metrics:read"
    ],
    "sandbox": true
  }
}