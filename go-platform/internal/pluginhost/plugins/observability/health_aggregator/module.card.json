{
  "specVersion": "1.1.0",
  "kind": "capability",
  "id": "detectviz.health_aggregator",
  "name": "health_aggregator",
  "version": "1.0.0",
  "responsibility": "Aggregates health metrics from various sources using configurable providers",
  "category": "capability",
  "capabilities": [
    "metrics_query",
    "batch_query",
    "aggregation",
    "caching"
  ],
  "dependencies": [],
  "permissions": ["net"],
  "resources": {
    "cpu": "100m",
    "memory": "128Mi"
  },
  "observability": {
    "metrics": [
      "plugin_runs_total",
      "plugin_duration_seconds_bucket",
      "health_aggregator_queries_total",
      "health_aggregator_query_duration_seconds"
    ],
    "spans": [
      "health_aggregator.query",
      "health_aggregator.batch_query"
    ],
    "logs_required": true
  },
  "author": "Detectviz Platform Team",
  "license": "MIT"
}