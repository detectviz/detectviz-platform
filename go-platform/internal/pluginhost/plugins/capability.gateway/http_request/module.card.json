{
  "specVersion": "1.1.0",
  "kind": "plugin",
  "category": "capability.gateway",
  "id": "detectviz.plugins.http_request_gateway",
  "version": "0.1.0",
  "observability": { "spans": ["capability.request"] },
  "rate_limit": { "rps": 64, "burst": 128, "per_tenant": true },
  "a2a": { "concurrency_limit": 32, "queue_depth": 200 },
