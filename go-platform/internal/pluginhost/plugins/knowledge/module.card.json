{
  "$schema": "https://detectviz.dev/schemas/module.card.schema.json",
  "name": "knowledge_provider",
  "version": "1.0.0",
  "description": "Provides knowledge management capabilities for storing and retrieving postmortem knowledge",
  "language": "go",
  "entrypoint": "plugin.go",
  "classification": {
    "role": "capability",
    "category": "storage.kv"
  },
  "dependencies": {
    "requires": [
      {
        "name": "detectviz.contracts",
        "version": ">=1.0.0",
        "type": "proto"
      }
    ]
  },
  "runtime": {
    "resources": {
      "min_memory_mb": 128,
      "max_memory_mb": 512,
      "min_cpu_cores": 0.2,
      "max_cpu_cores": 1.0
    },
    "timeout_seconds": 60
  },
  "observability": {
    "metrics_enabled": true,
    "tracing_enabled": true,
    "logging_level": "info",
    "tags": {
      "component": "knowledge_provider",
      "layer": "plugin"
    }
  },
  "security": {
    "permissions": [
      "net",
      "fs:read",
      "fs:write"
    ],
    "sandbox": true
  }
}