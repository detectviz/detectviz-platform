{
  "$schema": "https://detectviz.dev/schemas/module.card.schema.json",
  "specVersion": "1.1.0",
  "name": "http_request",
  "version": "1.0.0",
  "description": "A gateway plugin to make external HTTP requests.",
  "language": "go",
  "entrypoint": "plugin.go",
  "classification": {
    "role": "plugin.gateway",
    "category": "gateway"
  },
  "dependencies": {
    "requires": [
      {
        "name": "detectviz.contracts",
        "version": ">=1.0.0",
        "type": "proto"
      }
    ]
  },
  "runtime": {
    "resources": {
      "min_memory_mb": 32,
      "max_memory_mb": 128
    },
    "timeout_seconds": 60
  },
  "observability": {
    "metrics_enabled": true,
    "tracing_enabled": true,
    "logging_level": "info",
    "tags": {
      "component": "http_request"
    }
  },
  "security": {
    "permissions": [
      "net"
    ],
    "sandbox": true
  }
}