{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detectviz Module Card",
  "type": "object",
  "required": [
    "specVersion",
    "kind",
    "id",
    "responsibility"
  ],
  "properties": {
    "specVersion": {
      "type": "string",
      "description": "Module Card 規格版本（SemVer），此版為 1.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "capability",
        "memory",
        "plugin"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "responsibility": {
      "type": "string",
      "minLength": 8
    },
    "role": {
      "type": "string",
      "description": "模組職責分層：\n- agent.coordinator：任務分解、決策與路由（ADK 協調者）\n- agent.tool_exec：以工具為中心執行單一/窄域任務（ADK 工具執行者）\n- tool：與外部系統交互的具體介面（HTTP/gRPC/DB/Shell 等）\n- capability：可組合的能力單元（模型/檢索/規則/策略），不直接對外部副作用\n- plugin.gateway：Go 平台的外掛（telegraf-like），透過 ToolBridge 暴露為遠端工具\n- memory.backend：記憶體後端（Redis/向量庫/雲端儲存）\n- security.module：認證/授權/金鑰管理等安全模組\n- observability.module：追蹤/日誌/效能/告警等觀測模組\n- storage.module：一般化儲存抽象（KV/Blob/Vector）\n",
      "enum": [
        "agent.coordinator",
        "agent.tool_exec",
        "tool",
        "capability",
        "plugin.gateway",
        "memory.backend",
        "security.module",
        "observability.module",
        "storage.module"
      ]
    },
    "category": {
      "type": "string",
      "description": "分類對齊 Telegraf 與 ADK：\n- plugin 類：collector.input / transform.processor / aggregate.aggregator / sink.output / gateway\n- ADK/平台：llm / retriever / workflow / a2a / capability\n- 儲存/安全/觀測：memory.backend / security.authn / security.authz / observability.exporter / observability.processor\n- 通用儲存：storage.blob / storage.kv / storage.vector\n",
      "enum": [
        "collector.input",
        "transform.processor",
        "aggregate.aggregator",
        "sink.output",
        "gateway",
        "llm",
        "retriever",
        "workflow",
        "a2a",
        "capability",
        "memory.backend",
        "security.authn",
        "security.authz",
        "observability.exporter",
        "observability.processor",
        "storage.blob",
        "storage.kv",
        "storage.vector"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "schema"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "schema"
        ]
      }
    },
    "a2a": {
      "type": "object",
      "description": "Agent-to-Agent 協作最小欄位與容量限制",
      "properties": {
        "capability_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concurrency_limit": {
          "type": "integer",
          "minimum": 1,
          "default": 16
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 0,
          "default": 100
        },
        "timeouts_ms": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "integer",
              "minimum": 100
            },
            "task": {
              "type": "integer",
              "minimum": 1000
            },
            "total": {
              "type": "integer",
              "minimum": 1000
            }
          }
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "spans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logs_required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "net",
          "fs",
          "proc",
          "secrets"
        ]
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "agent"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "role"
        ],
        "not": {
          "required": [
            "category"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plugin"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "category"
        ],
        "not": {
          "required": [
            "role"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "capability"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "capability"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "memory"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "memory.backend"
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$comment": " | updated role/category enums at 2025-08-09T09:03:49.764350Z"
}