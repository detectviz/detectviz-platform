{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detectviz ADK Plugin Manifest",
  "type": "object",
  "required": [
    "manifestVersion",
    "id",
    "version",
    "type",
    "entryPoint",
    "hostCompatibility"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "type": {
      "type": "string",
      "enum": [
        "agent",
        "tool",
        "capability",
        "memory"
      ]
    },
    "entryPoint": {
      "type": "string"
    },
    "hostCompatibility": {
      "type": "object",
      "required": [
        "apiVersion"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "pattern": "^v\\d+(\\.\\d+)?(\\.\\d+)?$"
        },
        "runtimeVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "net",
          "fs",
          "proc",
          "secrets"
        ]
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}