{
  "specVersion": "1.1.0",
  "kind": "capability",
  "id": "detectviz.capabilities.weaviate",
  "responsibility": "Provides vector database storage and semantic search capabilities for knowledge management",
  "category": "capability",
  "inputs": [
    {
      "name": "documents",
      "schema": "array of objects with text and metadata"
    },
    {
      "name": "query",
      "schema": "string or embedding vector"
    }
  ],
  "outputs": [
    {
      "name": "search_results",
      "schema": "array of matched documents with similarity scores"
    }
  ],
  "observability": {
    "spans": [
      "capability.weaviate.store",
      "capability.weaviate.search",
      "capability.weaviate.delete"
    ],
    "metrics": [
      "weaviate_operations_total",
      "weaviate_operation_duration_seconds"
    ],
    "logs_required": true
  },
  "dependencies": [
    "weaviate-client>=4.0.0",
    "requests>=2.28.0"
  ],
  "permissions": [
    "net"
  ],
  "version": "1.0.0",
  "resources": {
    "cpu": "100m",
    "memory": "128Mi"
  }
}