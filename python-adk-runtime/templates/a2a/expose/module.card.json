{
  "specVersion": "1.1.0",
  "kind": "agent",
  "id": "detectviz.templates.a2a.expose",
  "version": "0.1.0",
  "responsibility": "以 A2A 方式暴露代理，供跨進程/跨語言/跨團隊重用。",
  "role": "custom",
  "inputs": [
    {
      "name": "input",
      "schema": "schemas/generic.input.v1"
    }
  ],
  "outputs": [
    {
      "name": "output",
      "schema": "schemas/generic.output.v1"
    }
  ],
  "a2a": {
    "capability_tags": [
      "serve",
      "remote"
    ],
    "concurrency_limit": 16,
    "queue_depth": 200,
    "timeouts_ms": {
      "tool": 2000,
      "task": 8000,
      "total": 12000
    }
  },
  "observability": {
    "spans": [
      "agent.run"
    ],
    "metrics": [
      "agent_runs_total"
    ]
  },
  "rate_limit": {
    "rps": 64,
    "burst": 128,
    "per_tenant": true
  }
}