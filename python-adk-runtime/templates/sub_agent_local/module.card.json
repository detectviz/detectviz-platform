{
  "specVersion": "1.1.0",
  "kind": "agent",
  "id": "detectviz.templates.sub_agent_local",
  "version": "0.1.0",
  "responsibility": "A template for a local sub-agent. Its responsibility should be clearly defined here.",
  "role": "agent.tool_exec",
  "dependencies": [
    "google-adk>=0.0.0"
  ],
  "observability": {
    "logs_required": true,
    "spans": [
      "agent.run"
    ]
  },
  "a2a": {
    "concurrency_limit": 1,
    "timeouts_ms": {
      "tool": 2000,
      "task": 8000,
      "total": 12000
    }
  }
}
